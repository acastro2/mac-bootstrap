# den config: public, committed. No secrets here: they live in the 1Password
# Document `den` (den.json). Machine-only overrides: ~/.config/den/local.env.

# ── Identity ──────────────────────────────────────────────────────────
OP_VAULT="Private"                       # 1Password vault holding the `den` Document
GIT_NAME="Alexandre Castro"
GIT_EMAIL="alexandre.castro@outlook.com"

# ── Repos ─────────────────────────────────────────────────────────────
REPO_URL="https://github.com/acastro2/mac-bootstrap.git"
REPO_DIR="${HOME}/Developer/github/acastro2/mac-bootstrap"
OPENCODE_CONFIG_REPO="acastro2/opencode_config"
CLAUDE_CONFIG_REPO="acastro2/.claude"
OPENCODE_SKILLS_REPO="https://github.com/acastro2/alex-skills.git"

# ── Toggles (1 = on, 0 = off) ─────────────────────────────────────────
DEN_MACOS_DEFAULTS=1      # Dock, key repeat, dark mode
DEN_TOUCHID_SUDO=1        # Touch ID for sudo on the Mac (pam_tid + pam_reattach)
DEN_REX=1                 # Rex app, its skill, Rex Agent Restore
DEN_OPENCODE_WEB=1        # OpenCode web UI on the tailnet
DEN_VM=1                  # the Lima agent VM and its vm-up login agent
DEN_BROWSE_TUNNEL=1       # VM agents drive the Mac browser through the relay

# ── Settings ──────────────────────────────────────────────────────────
AGENT_VM="agent"                         # Lima instance name
DEN_AGENTS="opencode claude cortex"      # agent CLIs to install; 0 turns the phase off
OPENCODE_WEB_PORT="49374"                # fixed port so the phone URL stays stable
REX_RESTORE_AGENTS="claude"              # agents Rex Agent Restore hooks
OBSIDIAN_SYNC_VAULT=""                   # Obsidian Sync remote vault the VM syncs; empty = pick in preflight
