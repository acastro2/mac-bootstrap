# Brewfile.linux — the VM list: the dev box. The Mac uses Brewfile.
# Apply with: den up --only=packages
# No docker, docker-compose, colima or lima here: Homebrew's docker shadows
# /usr/bin/docker, and the guest gets Docker Engine from Docker's apt repo.

# ── Shell, repos, CLI utilities ───────────────────────────────────────
brew "git"
brew "gh"
brew "zsh"             # Linux distros may not ship zsh
brew "carapace"
brew "starship"        # cross-shell prompt
brew "chezmoi"         # dotfiles
brew "fzf"
brew "jq"
brew "yq"
brew "ripgrep"
brew "fd"
brew "bat"
brew "eza"             # modern ls
brew "mcat"            # modern cat
brew "neovim"
brew "gum"
brew "uv"              # Playwright and browser-use run as uv tools here
brew "ffmpeg"
brew "asdf"

# ── Toolchains and platform ────────────────────────────────────────────
brew "mise"            # toolchain manager (Go, Node, Python, tflint, ...)
brew "llhttp"          # mise Node dep — prevent brew cleanup from breaking node
brew "kubectl"
brew "k9s"
brew "helm"
brew "awscli"
brew "crane"           # inspect/copy container images without pulling
brew "snowflake-cli"
brew "pgcli"
brew "pre-commit"
brew "gitleaks"
brew "repomix"         # pack a repo into a single file for LLM context
brew "doggo"           # DNS client (dig alternative)
# Latest major, unversioned: the VM is rebuilt, so it always gets the newest.
brew "postgresql", restart_service: false, link: true  # keg-only: link it so psql and postgres are on PATH
brew "redis", restart_service: false

# ── Taps ───────────────────────────────────────────────────────────────
tap "anomalyco/tap"
brew "opentunnel"

# Rex Agent Restore: resumes agent chats after a Rex restart (community, MIT).
# Its repo is not homebrew-*, so the tap needs the URL.
tap "pattont/rex-agent-restore", "https://github.com/pattont/RexAgentRestore"
brew "pattont/rex-agent-restore/rex-agent-restore"
