#!/usr/bin/env bash
# Pull API keys from 1Password into ~/.config/zsh/.api-keys.zsh (chmod 600).
# Same key list as bootstrap.sh's auth phase. Usage:
#   eval "$(op signin)" && op-sync-api-keys [vault]
set -euo pipefail
VAULT="${1:-Private}"
OUT="$HOME/.config/zsh/.api-keys.zsh"
TMP="$OUT.tmp"
op whoami >/dev/null 2>&1 || { echo 'Not signed in. Run: eval "$(op signin)"' >&2; exit 1; }
umask 077
: > "$TMP"
while IFS='|' read -r env_name item_name field_name; do
  if value="$(op read "op://${VAULT}/${item_name}/${field_name:-password}" 2>/dev/null)"; then
    printf 'export %s=%s\n' "$env_name" "$(printf '%s' "$value" | jq -Rs .)" >> "$TMP"
    echo "  ✓ $env_name"
  else
    echo "  ✗ $env_name (op://${VAULT}/${item_name} not found)" >&2
  fi
done <<'KEYS'
OPENCODE_API_KEY|opencode-api-key
OPENAI_API_KEY|openai-api-key
CONTEXT7_API_KEY|context7-api-key
DEVTO_API_KEY|devto-api-key
OREILLY_API_TOKEN|oreilly-api-token
GOOGLE_API_KEY|google-api-key
AZURE_DEVOPS_PAT|ado-pat
GRAFANA_SERVICE_ACCOUNT_TOKEN|grafana-service-account-token
EXA_API_KEY|EXA API Key
RESEND_API_KEY|Resend API Credential|credential
KEYS
zsh -n "$TMP"
mv "$TMP" "$OUT"
echo "Wrote $OUT — open a new shell to load it."
