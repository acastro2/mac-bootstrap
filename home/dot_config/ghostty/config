# ~/.config/ghostty/config — managed by chezmoi
font-family = JetBrainsMono Nerd Font
font-size = 14
theme = iTerm2 Dark Background
window-padding-x = 12
window-padding-y = 12
window-decoration = true
macos-titlebar-style = tabs
background-opacity = 0.97
background-blur-radius = 20
cursor-style = block
cursor-style-blink = false
# Explicit integration (not detect) so new tabs inherit the live folder.
shell-integration = zsh
copy-on-select = clipboard
confirm-close-surface = false

# ── Workflow ────────────────────────────────────────────────────────
# Quake-style dropdown terminal: binding toggle_quick_terminal enables it.
keybind = ctrl+shift+space=toggle_quick_terminal

# Restore all tabs/windows (and quick-terminal state) on next launch.
window-save-state = always

# Hide the cursor while typing.
mouse-hide-while-typing = true
