# Terraform-plugin aliases backed by the toolchain this repo installs. The
# wrapper prefers OpenTofu but falls back to Terraform when that is present.
tf() {
  if (( $+commands[tofu] )); then
    tofu "$@"
  else
    terraform "$@"
  fi
}
