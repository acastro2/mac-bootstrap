grt() {
  local root
  root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    print -u2 'grt must run inside a Git worktree'
    return 1
  }
  cd $root
}

gpsup() {
  local branch
  branch=$(git branch --show-current)
  if [[ -z $branch ]]; then
    print -u2 'gpsup requires a named Git branch'
    return 1
  fi
  git push --set-upstream origin $branch
}

git-clean() {
  git rev-parse --is-inside-work-tree &>/dev/null || {
    print -u2 'git-clean must run inside a Git worktree'
    return 1
  }
  git remote get-url origin &>/dev/null || {
    print -u2 'git-clean requires an origin remote'
    return 1
  }
  git fetch --prune origin || return 1

  local default_ref
  default_ref=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null) || {
    print -u2 "Cannot detect origin's default branch. Run: git remote set-head origin --auto"
    return 1
  }

  local current_branch
  current_branch=$(git branch --show-current)
  local -a merged
  merged=($(git for-each-ref --format='%(refname:short)' "--merged=${default_ref}" refs/heads))
  merged=(${merged:#${current_branch}})
  merged=(${merged:#${default_ref#origin/}})

  if (( ${#merged[@]} == 0 )); then
    print "No local branches are merged into ${default_ref}."
    return 0
  fi

  local branch
  for branch in $merged; do
    git branch -d $branch
  done
}

