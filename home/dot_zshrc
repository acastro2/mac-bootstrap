# Zsh configuration managed by chezmoi.
# Framework: Zim (https://github.com/zimfw/zimfw). Modules live in ~/.zimrc.

# ── History ───────────────────────────────────────────────────────────
HISTFILE=${ZDOTDIR:-$HOME}/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS SHARE_HISTORY HIST_REDUCE_BLANKS

# ── Input ─────────────────────────────────────────────────────────────
bindkey -e
WORDCHARS=${WORDCHARS//[\/]}

# Module configuration read at init time.
ZSH_AUTOSUGGEST_MANUAL_REBIND=1
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)

# ── Environment ───────────────────────────────────────────────────────
# AWS SSO profiles belong in ~/.aws/config, not inherited shell credentials.
unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN AWS_PROFILE 2>/dev/null || true

# Deduplicated PATH; Homebrew and local tool bins first.
typeset -U path
for _brew_dir in \
  /opt/homebrew/bin /opt/homebrew/sbin \
  /usr/local/bin /usr/local/sbin \
  /home/linuxbrew/.linuxbrew/bin /home/linuxbrew/.linuxbrew/sbin; do
  [[ -d $_brew_dir ]] && path=($_brew_dir $path)
done
path=($HOME/.local/bin $HOME/.opencode/bin $path)
unset _brew_dir

export TENV_AUTO_INSTALL=true
export OPENCODE_EXPERIMENTAL=true
export GRAFANA_SERVER=https://grafana.attainfinance.com
export GRAFANA_ORG_ID=1
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'

# Trust the corporate CA for tools that don't use the macOS keychain.
# Opt-in: only activates if ~/.config/corporate-ca-bundle.pem exists.
# Personal machines: leave the file out — this block no-ops.
_corporate_ca_bundle=$HOME/.config/corporate-ca-bundle.pem
if [[ -f $_corporate_ca_bundle ]]; then
  export NODE_EXTRA_CA_CERTS=$_corporate_ca_bundle  # Node-based tools and MCP clients
  export REQUESTS_CA_BUNDLE=$_corporate_ca_bundle   # Python requests-based tools
  export SSL_CERT_FILE=$_corporate_ca_bundle        # OpenSSL-native tools
  export CURL_CA_BUNDLE=$_corporate_ca_bundle       # curl and anything linked against it
  export GIT_SSL_CAINFO=$_corporate_ca_bundle       # git (Homebrew build uses OpenSSL)
  export PIP_CERT=$_corporate_ca_bundle             # pip itself
  export AWS_CA_BUNDLE=$_corporate_ca_bundle        # AWS SDKs and CLI
fi
unset _corporate_ca_bundle

# ── Zim framework ─────────────────────────────────────────────────────
ZIM_HOME=${ZDOTDIR:-$HOME}/.zim
if [[ ! -e ${ZIM_HOME}/zimfw.zsh ]]; then
  mkdir -p ${ZIM_HOME}
  if (( $+commands[curl] )); then
    curl -fsSL -o ${ZIM_HOME}/zimfw.zsh \
      https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
  else
    wget -nv -O ${ZIM_HOME}/zimfw.zsh \
      https://github.com/zimfw/zimfw/releases/latest/download/zimfw.zsh
  fi
fi
if [[ ! ${ZIM_HOME}/init.zsh -nt ${ZDOTDIR:-$HOME}/.zimrc ]]; then
  source ${ZIM_HOME}/zimfw.zsh init
fi
[[ -e ${ZIM_HOME}/init.zsh ]] && source ${ZIM_HOME}/init.zsh

# Up/down arrow searches history for what you already typed.
if (( $+widgets[history-substring-search-up] )); then
  [[ -n $terminfo[kcuu1] ]] && bindkey "$terminfo[kcuu1]" history-substring-search-up
  [[ -n $terminfo[kcud1] ]] && bindkey "$terminfo[kcud1]" history-substring-search-down
fi

# ── Tool integrations (completion system is live from here on) ────────
(( $+commands[mise] )) && eval "$(mise activate zsh)"

# Bash-style completion scripts (yargs CLIs), e.g. the cached opencode script.
autoload -U +X bashcompinit && bashcompinit
[[ -r $HOME/.config/zsh/opencode-completions.zsh ]] && source $HOME/.config/zsh/opencode-completions.zsh

# Carapace structured completions for hundreds of CLIs.
(( $+commands[carapace] )) && source <(carapace _carapace)
zstyle ':completion:*' menu search
setopt MENU_COMPLETE

# fzf: fuzzy Ctrl-R history search, Ctrl-T file insert, Alt-C cd.
(( $+commands[fzf] )) && eval "$(fzf --zsh)"

# Starship prompt.
(( $+commands[starship] )) && eval "$(starship init zsh)"

